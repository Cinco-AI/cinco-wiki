{
  "name": "cinco-wiki",
  "version": "1.0.0",
  "private": true,
  "description": "Cinco Wiki — application collaborative de prise de notes",
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "dev": "sst dev",
    "deploy": "sst deploy --stage production",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:shared": "npm run build --workspace packages/shared",
    "frontend": "npm run dev --workspace packages/frontend",
    "seed:admin": "node scripts/seed-admin.mjs"
  },
  "devDependencies": {
    "sst": "^3.3.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "npm@11.6.2"
}
