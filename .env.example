# Variables backend. En déploiement (Serverless Framework), elles viennent de
# SSM Parameter Store (clés /cinco-wiki/<stage>/<NOM>) — pousser via :
#   ./scripts/set-secrets.sh <stage>      (lit ce fichier .env)
# Le script crée les paramètres SSM correspondants :
#
# | Variable Lambda | Paramètre SSM                       | Type          |
# |-----------------|-------------------------------------|---------------|
# | MONGODB_URI     | /cinco-wiki/<stage>/MONGODB_URI     | SecureString  |
# | JWT_SECRET      | /cinco-wiki/<stage>/JWT_SECRET      | SecureString  |
# | MONGODB_DB      | /cinco-wiki/<stage>/MONGODB_DB      | String        |
# | CORS_ORIGINS    | /cinco-wiki/<stage>/CORS_ORIGINS    | String        |
# | OPENAI_API_KEY  | /cinco-wiki/<stage>/OPENAI_API_KEY  | SecureString  | (Lambda linkSummarizer)
#
# BUCKET_NAME est dérivé du service+stage par serverless.yml
# (défaut cinco-wiki-uploads-<stage>) ; surchargeable via --param="bucketName=...".
#
# IMPORTANT : toujours guillemeter les valeurs (le `&` de l'URI casserait `source`).

# Guillemets obligatoires : l'URI contient & et des caractères spéciaux.
MONGODB_URI="mongodb+srv://cinco-wiki_user:CHANGE_ME@cluster0.abcde.mongodb.net/cinco-wiki?retryWrites=true&w=majority"
MONGODB_DB="cinco-wiki"
JWT_SECRET="super_secret_jwt_key_CHANGE_ME_in_production_64chars_minimum"
CORS_ORIGINS="http://localhost:3000,https://cinco-wiki.netlify.app"
OPENAI_API_KEY="sk-proj-1234567890"

# Qdrant + Neo4j (optionnel) — GraphRAG pour l'assistant /rag/chat
# En local : npm run qdrant:up  (démarre qdrant + neo4j via docker-compose.rag.yml)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="cinco_wiki"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="changeme"
LLM_PROVIDER="openai"
CHAT_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# Région / profil AWS — optionnels. Lus par set-secrets.sh ET (si exportés dans le
# shell) par `serverless deploy`. Décommenter pour fixer ici plutôt que dans le shell.
# AWS_REGION="eu-west-3"
# AWS_PROFILE="cinco"
