# Secrets SST — injectés via `sst secret set <NOM> "<valeur>"`
# Ces variables ne sont PAS chargées directement depuis un .env en production.
# Ce fichier sert de référence pour les valeurs attendues.

# URI de connexion MongoDB Atlas
MONGODB_URI=mongodb+srv://noteshare_user:CHANGE_ME@cluster0.abcde.mongodb.net/noteshare?retryWrites=true&w=majority

# Base de données MongoDB
MONGODB_DB=noteshare

# Clé secrète JWT (chaîne aléatoire longue)
JWT_SECRET=super_secret_jwt_key_CHANGE_ME_in_production_64chars_minimum

# Nom du bucket S3 (géré automatiquement par SST, ne pas changer manuellement)
BUCKET_NAME=noteshare-uploads-dev

# Origines CORS autorisées (séparées par des virgules ou * pour tout autoriser)
CORS_ORIGINS=http://localhost:3000,https://noteshare.netlify.app
