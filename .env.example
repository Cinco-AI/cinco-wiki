# Secrets SST — injectés via `sst secret set <NOM> "<valeur>"`
# En production / `sst dev`, ces valeurs viennent des secrets SST (pas d'un .env).
# Ce fichier sert de référence pour le dev local hors SST ou pour `dev-export.sh`.
#
# | Secret SST  | Variable Lambda |
# |-------------|-----------------|
# | MongoUri    | MONGODB_URI     |
# | MongoDb     | MONGODB_DB      |
# | JwtSecret   | JWT_SECRET      |
# | BucketName  | BUCKET_NAME     |
# | CorsOrigins | CORS_ORIGINS    |

MONGODB_URI=mongodb+srv://cinco-wiki_user:CHANGE_ME@cluster0.abcde.mongodb.net/cinco-wiki?retryWrites=true&w=majority
MONGODB_DB=cinco-wiki
JWT_SECRET=super_secret_jwt_key_CHANGE_ME_in_production_64chars_minimum
BUCKET_NAME=cinco-wiki-uploads-dev
CORS_ORIGINS=http://localhost:3000,https://cinco-wiki.netlify.app
